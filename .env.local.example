# 本地开发/部署环境变量配置
# 复制此文件为 .env.local 并填入实际值
# cp .env.local.example .env.local

# 数据库配置（二选一）
# 方式 1: 完整连接串（推荐）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibeai?sslmode=disable

# 方式 2: 分段配置（用于 Docker 访问宿主机数据库）
# PGHOST=172.18.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=vibeai
# PGSSLMODE=disable

# 应用配置
NODE_ENV=production
PORT=5000

# JWT 配置（生产环境请修改为随机字符串）
JWT_SECRET=your-jwt-secret-change-in-production

# HMR 配置（开发服务器通过 nginx 反向代理时需要）
# 如果前端通过 nginx 代理访问（如 8082 → 5000），设置此值为代理端口
# 沙箱环境无需设置（默认 443）
# HMR_CLIENT_PORT=8082
