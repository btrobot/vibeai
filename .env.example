# VibeAI - Production deployment template (Forge managed)
# Copy to .env and fill in actual values.
#
# Architecture:
#   DB  = postgres:16-alpine (Docker, named volume pgdata)
#   App = NestJS, connects to db:5432 via compose internal network
#   Caddy (auto-ingress) reaches app via upstream network
#
# === Required ===
COMPOSE_PROJECT_NAME=vibeai
IMAGE_NAME=ccr.ccs.tencentyun.com/nodecoda/vibeai:1.0.0

# Database
DB_PASSWORD=change-this-to-a-secure-password

# Auth
JWT_SECRET=change-this-to-a-random-secret

# === Optional ===
APP_PORT=5000
CORS_ORIGIN=https://test.nodecoda.com,https://mcp-test.nodecoda.com
UPSTREAM_NETWORK=upstream
MEM_LIMIT=512m
PIDS_LIMIT=256

# AI Gateway (leave empty for mock mode)
REPLICATE_API_TOKEN=
REPLICATE_BASE_URL=https://api.replicate.com
COZE_PROJECT_DOMAIN_DEFAULT=https://test.nodecoda.com
