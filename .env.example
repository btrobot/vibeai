# ===== Application =====
NODE_ENV=production
BACKEND_PORT=3001
DEPLOY_RUN_PORT=5000
CORS_ORIGIN=http://localhost:5000

# ===== Database =====
DATABASE_URL=postgres://vibeai:vibeai@localhost:5432/vibeai

# ===== JWT =====
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Storage (local) =====
STORAGE_PROVIDER=local

# ===== Storage (S3) =====
# STORAGE_PROVIDER=s3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=vibeai-uploads
# AWS_S3_ENDPOINT=https://s3.amazonaws.com

# ===== AI Gateway — Coze SDK (Image/Video/LLM 适配器) =====
# 未设置时三个 Coze 适配器自动进入 Mock 模式
# COZE_LOOP_API_TOKEN=your-coze-loop-api-token
# COZE_WORKLOAD_API_TOKEN=your-coze-workload-api-token
# COZE_LOOP_BASE_URL=https://api.coze.cn

# ===== AI Gateway — Replicate (ReplicateAdapter) =====
# 未设置时 ReplicateAdapter 自动进入 Mock 模式
# REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxx
# REPLICATE_BASE_URL=https://api.replicate.com

# ===== AI Gateway — 媒体 URL 解析 =====
# 用户上传文件返回相对路径 /api/storage/serve/...，AI SDK 需要公网可达的绝对 URL
# 部署到服务器后必须设置为公网访问地址（不带尾斜杠）
# 本地开发可不设置（仅影响真实 AI 调用时的图片输入）
# COZE_PROJECT_DOMAIN_DEFAULT=http://124.220.35.168:6060