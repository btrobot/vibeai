{
  "name": "vibeai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash ./scripts/dev.sh",
    "dev:frontend": "vite",
    "dev:backend": "cd server && pnpm dev",
    "build": "bash ./scripts/build.sh",
    "start": "bash ./scripts/start.sh",
    "preinstall": "npx only-allow pnpm",
    "ts-check": "tsc -p tsconfig.json",
    "lint": "eslint . --quiet",
    "design-check": "bash scripts/design-check.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:build": "eslint . --quiet",
    "test:e2e": "npx playwright test",
    "validate": "pnpm ts-check && pnpm lint:build && pnpm test && cd server && pnpm test",
    "validate:docker": "bash scripts/docker-validate.sh",
    "gate:precommit": "pnpm validate",
    "gate:deploy": "pnpm validate && pnpm test:coverage && cd server && pnpm test:coverage"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^1",
    "@radix-ui/react-label": "^2",
    "@radix-ui/react-separator": "^1",
    "@radix-ui/react-slot": "^1",
    "@radix-ui/react-tabs": "^1",
    "@radix-ui/react-toast": "^1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.479",
    "postgres": "^3.4.9",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "tailwind-merge": "^3",
    "zod": "^3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^3.2.0",
    "coze-coding-dev-sdk": "^0.7.24",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "js-yaml": "^5.2.3",
    "jsdom": "^26",
    "lint-staged": "^17.3.0",
    "msw": "^2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^7.2.4",
    "vitest": "^3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --quiet",
      "bash scripts/design-check.sh",
      "bash -c 'pnpm ts-check 2>&1 | tail -5'"
    ],
    "*.{js,jsx,mjs,cjs}": [
      "eslint --fix --quiet"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "pnpm": ">=9.0.0"
  }
}
