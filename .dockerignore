# =============================================
# .dockerignore — VibeAI Docker 构建上下文排除
# =============================================

# ─── 版本控制 ───
.git
.gitignore

# ─── 依赖（构建时在容器内安装）───
node_modules
**/node_modules

# ─── 构建产物（构建时在容器内生成）───
dist
server/dist
.vite

# ─── 测试 & 覆盖率（运行时需要但构建不需要）───
coverage
test-results
playwright-report
e2e
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
vitest.config.ts
vitest.config.*.ts
playwright.config.ts
tsconfig.json
tsconfig.*.json

# ─── 业务规范文件（仅文档，构建不需要）───
specs

# ─── CI/CD & GitHub ───
.github

# ─── Docker 自身（避免递归）───
Dockerfile*
docker-compose*
.dockerignore
scripts/docker-*.sh
scripts/validate-docker.sh
# 注意: scripts/detect-mirror.sh 和 scripts/start.sh 不能排除，Dockerfile 需要

# ─── 环境 & 密钥 ───
.env
.env.*
.env.local
.env.production

# ─── 文档 ───
*.md
LICENSE

# ─── IDE & OS ───
.DS_Store
.idea
.vscode
*.swp
*.swo
*.iml
Thumbs.db
ehthumbs.db

# ─── 日志 ───
*.log
npm-debug.log*
pnpm-debug.log*

# ─── 其他工作区 ───
worktrees
.cozeproj
